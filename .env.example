# TrustVault Environment Configuration Example
# Copy this file to .env and configure for your environment

# Security Settings
SECRET_KEY=generate-a-strong-random-key-in-production-min-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Database Selection: 'sqlite' or 'postgresql'
DB_ENGINE=sqlite

# PostgreSQL Configuration (used only when DB_ENGINE=postgresql)
DB_NAME=trustvault_db
DB_USER=trustvault_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Storage Configuration
PROTECTED_MEDIA_DIR=protected_media
MAX_UPLOAD_SIZE_MB=25

# Production HTTPS / Cookie Flags
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
