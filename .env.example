# TrustVault Environment Configuration Example
# Copy this file to .env and configure for your environment

# Security Settings
SECRET_KEY=generate-a-strong-random-key-in-production-min-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Database Configuration:
# - Local development: defaults to SQLite when DATABASE_URL is unset.
# - Production (Vercel / Render / PaaS): DATABASE_URL must be configured with PostgreSQL.
# - Silent fallback to SQLite is strictly disabled in production.
DB_ENGINE=sqlite

# Production PostgreSQL / Neon Serverless Connection String:
# DATABASE_URL=postgresql://<user>:<password>@<ep-pooler-id>.us-east-2.aws.neon.tech/neondb?sslmode=require
# CONN_MAX_AGE=0

# Individual PostgreSQL Configuration (used only when DB_ENGINE=postgresql and DATABASE_URL is unset)
DB_NAME=trustvault_db
DB_USER=trustvault_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Storage Configuration:
# - Local development: defaults to local filesystem (PROTECTED_MEDIA_DIR) when DOCUMENTS_STORAGE_BACKEND is 'local' or AWS credentials are unset.
# - Production (Vercel / Render / PaaS): Neon Object Storage (S3) is required.
# - Silent fallback to local storage is strictly disabled in production.
DOCUMENTS_STORAGE_BACKEND=s3
PROTECTED_MEDIA_DIR=protected_media
MAX_UPLOAD_SIZE_MB=25

# Neon Object Storage (S3-Compatible) Configuration:
AWS_ENDPOINT_URL_S3=https://your-neon-storage-endpoint.amazonaws.com
AWS_ACCESS_KEY_ID=your-neon-storage-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-access-key
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=trustvault-documents

# Production HTTPS / Cookie Flags
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
